{
  "id": "E91",
  "제목": "형식 예시 2 — addr·pops로 시작하는 체인과 단위 테스트 check",
  "담당": "송유진",
  "작성일": "2026-11-24",
  "방향": "표기 변형",
  "구분": "위반",
  "입력": "rop_vault의 pop rdi; ret(0x4011de, 6주차 풀이 주소)에 \"/bin/sh\" 주소를 넣고 libc ret gadget 11개를 이은 뒤 execve에 닿는 합성 체인. 그리고 gadget DB가 그 주소를 gadget으로 아는지 보는 단위 테스트",
  "기대 결과": "탐지(ROP). 첫 libc gadget 진입에서 과거 2(vuln 끝 ret → pop rdi; ret, 그 ret → libc gadget) + 미래로 연쇄 11 이상, execve 전에 멈춤. 단위 테스트는 통과",
  "근거": "과거 연쇄는 최근 간접 분기의 목적지가 gadget인 동안 센다(논문 V-C, design.md 1절)",
  "checks": [
    {
      "id": "ex-addr-pops",
      "synth": {
        "chain": [
          {
            "addr": "rop_vault+0x4011de",
            "pops": [
              "0x404060"
            ]
          },
          {
            "pick": {
              "asm": "^ret$"
            }
          },
          {
            "pick": {
              "asm": "^ret$"
            }
          },
          {
            "pick": {
              "asm": "^ret$"
            }
          },
          {
            "pick": {
              "asm": "^ret$"
            }
          },
          {
            "pick": {
              "asm": "^ret$"
            }
          },
          {
            "pick": {
              "asm": "^ret$"
            }
          },
          {
            "pick": {
              "asm": "^ret$"
            }
          },
          {
            "pick": {
              "asm": "^ret$"
            }
          },
          {
            "pick": {
              "asm": "^ret$"
            }
          },
          {
            "pick": {
              "asm": "^ret$"
            }
          },
          {
            "pick": {
              "asm": "^ret$"
            }
          }
        ],
        "ending": "execve"
      },
      "expect": {
        "verdict": "ROP",
        "chain_len_min": 11,
        "past_len": 2,
        "gadgets_nonempty": true
      }
    },
    {
      "id": "ex-unit-db",
      "pytest": "cases/extra/examples/unit/test_example_db.py::test_pop_rdi_ret_is_gadget",
      "expect": {
        "pass": true
      }
    }
  ]
}
