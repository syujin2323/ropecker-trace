            }
          },
          {
            "pick": {
              "asm": "^ret$"
            }
          },
          {
            "pick": {
              "asm": "^ret$"
            }
          },
          {
            "pick": {
              "asm": "^ret$"
            }
          }
        ],
        "ending": "stop"
      },
      "expect": {
        "verdict": "ROP",
        "chain_len": 11,
        "detect_step_max": 3
      }
    },
