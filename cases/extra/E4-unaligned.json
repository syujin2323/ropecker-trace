            }
          },
          {
            "pick": {
              "asm": "^ret$",
              "aligned": false
            }
          },
          {
            "pick": {
              "asm": "^ret$",
              "aligned": false
            }
          },
          {
            "pick": {
              "asm": "^ret$",
              "aligned": false
            }
          },
          {
            "pick": {
              "asm": "^ret$",
              "aligned": false
            }
          }
        ],
        "ending": "execve"
      },
      "args": [
        "--align-check"
      ],
      "expect": {
        "verdict": "ROP",
        "gadgets_nonempty": true
      }
    },
    {
      "id": "e4-unit-unaligned",
      "pytest": "cases/extra/unit/test_e4_unaligned.py::test_unaligned_gadget_is_in_db",
      "expect": {
        "pass": true
